@tool
extends Node2D

## The next zone, for example L01S02.
@export var next_level: String = ""
## Original atlas identifiers and dimensions, used by the game renderer.
@export var tilesets: Array[Dictionary] = []

func _draw() -> void:
	if not Engine.is_editor_hint() and not has_meta("preview_for_test"):
		return
	draw_rect(Rect2(0, 0, 512, 352), Color.BLACK)
	# Stars are generated by PlayScreen in melonJS, rather than stored in TMX.
	# Use the same seed and tiles as the Godot game for a stable editor preview.
	var random := RandomNumberGenerator.new()
	random.seed = 1987
	var texture: Texture2D = load("res://assets/images/tiles.png")
	for i in 50:
		var x := random.randi_range(0, 31) * 16
		var y := random.randi_range(0, 17) * 16
		var gid := random.randi_range(10, 14)
		var frame := gid - 1
		var columns := texture.get_width() / 16
		draw_texture_rect_region(texture, Rect2(x, y, 16, 16), Rect2((frame % columns) * 16, (frame / columns) * 16, 16, 16))
